{
  "name": "viell-effect-schema-http",
  "version": "0.6.1",
  "description": "Consumer-owned HTTP contracts composed with Effect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viell-dev/slop-effect-schema-http.git"
  },
  "homepage": "https://viell-dev.github.io/slop-effect-schema-http/",
  "bugs": {
    "url": "https://github.com/viell-dev/slop-effect-schema-http/issues"
  },
  "author": "viell",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./Body": {
      "types": "./dist/http/Body.d.ts",
      "default": "./dist/http/Body.js"
    },
    "./Interaction": {
      "types": "./dist/concurrency/Interaction.d.ts",
      "default": "./dist/concurrency/Interaction.js"
    },
    "./Operation": {
      "types": "./dist/http/Operation.d.ts",
      "default": "./dist/http/Operation.js"
    },
    "./Policy": {
      "types": "./dist/http/Policy.d.ts",
      "default": "./dist/http/Policy.js"
    },
    "./Request": {
      "types": "./dist/http/Request.d.ts",
      "default": "./dist/http/Request.js"
    },
    "./Response": {
      "types": "./dist/http/Response.d.ts",
      "default": "./dist/http/Response.js"
    },
    "./Transport": {
      "types": "./dist/http/Transport.d.ts",
      "default": "./dist/http/Transport.js"
    },
    "./UrlEncoding": {
      "types": "./dist/http/UrlEncoding.d.ts",
      "default": "./dist/http/UrlEncoding.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "run-p check:*",
    "check:tsc": "tsc --noEmit",
    "check:prettier": "prettier --check .",
    "check:mdrefine": "mdrefine format --check",
    "format": "run-s format:*",
    "format:prettier": "prettier --write .",
    "format:mdrefine": "mdrefine format --write",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint .",
    "lint:mdrefine": "mdrefine lint",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/registry.test.mjs scripts/live.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check-live": "node scripts/check-live.mjs",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/check-doc-links.mjs",
    "docs:preview": "vite preview --host 127.0.0.1 --outDir docs/.vitepress/dist --base /slop-effect-schema-http/",
    "docs:examples": "tsc -p tsconfig.examples.json && node scripts/check-doc-examples.mjs && node examples/guides.mjs && node examples/modules.mjs && node examples/recipes.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "keywords": [
    "effect",
    "http",
    "schema"
  ],
  "peerDependencies": {
    "effect": "^4.0.7"
  },
  "overrides": {
    "minimatch@10": "11.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "effect": "^4.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.92.0",
    "mdrefine": "^0.7.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.1.0"
  }
}
