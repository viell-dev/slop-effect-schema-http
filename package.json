{
  "name": "viell-effect-schema-http-hostile-suite",
  "version": "0.0.0",
  "private": true,
  "description": "Server-backed hostile-API integration suite for viell-effect-schema-http.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "library": "node scripts/library.mjs",
    "check": "run-p check:*",
    "check:tsc": "tsc --noEmit",
    "check:prettier": "prettier --check .",
    "check:catalogue": "node scripts/catalogue.mjs",
    "check:boundaries": "node scripts/boundaries.mjs",
    "check:boundaries-test": "node --test scripts/boundaries.test.mjs",
    "lint": "oxlint",
    "test": "run-s test:node test:browser test:catalogue",
    "test:node": "vitest run --project node --reporter=default --reporter=junit --outputFile.junit=artifacts/junit-node.xml",
    "test:browser": "vitest run --project browser --reporter=default --reporter=junit --outputFile.junit=artifacts/junit-browser.xml",
    "test:catalogue": "node scripts/catalogue.mjs --results artifacts/junit-node.xml artifacts/junit-browser.xml",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@effect/vitest": "4.0.7",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.0.5",
    "effect": "4.0.7",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
