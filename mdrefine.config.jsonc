{
  "$schema": "./node_modules/mdrefine/config.schema.json",
  "extends": ["recommended", "github"],
  "rules": {
    "style/wrap": ["warn", { "width": 100 }],
  },
  "overrides": [
    {
      "files": ["docs/**/*.md"],
      "dialect": "vitepress",
      "vitepress": { "srcDir": "docs" },
    },
  ],
}
