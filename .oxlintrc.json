{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "artifacts/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**"
  ],
  "rules": {
    "eslint/no-underscore-dangle": "off"
  }
}
